# These values are read only by server/index.mjs and never shown in the teacher UI.
# Kimi handles task-picture understanding and handwriting OCR.
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_VISION_MODEL=kimi-k2.6

# DeepSeek handles criteria generation and grading from confirmed text.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-flash

# Local development may leave APP_PASSWORD blank. Cloud deployment must set a strong project-only password.
APP_USERNAME=teacher
APP_PASSWORD=
REQUIRE_APP_PASSWORD=0
REQUIRE_MODEL_KEYS=0

# Comma-separated origins. GitHub Pages uses the origin only, without the repository path.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174

HOST=127.0.0.1
PORT=8788

# Cost and abuse controls. These limits apply per running function instance.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
OCR_MAX_OUTPUT_TOKENS=4096
GRADE_MAX_OUTPUT_TOKENS=4096
CRITERIA_MAX_OUTPUT_TOKENS=2048
